# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BACKEND SEGURO OLLAMA
# ==============================================================================

# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta do servidor backend HTTP
PORT=3000

# URL base da API do Ollama
# No Mac local (com túnel SSH ou local): http://localhost:11434
# No ambiente Docker de produção com rede ia-interna: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Timeout para requisições ao Ollama em milissegundos (padrão: 120000 = 2 minutos)
OLLAMA_TIMEOUT=120000

# Origens autorizadas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173

# Lista restrita de modelos autorizados (separados por vírgula)
# Exemplo: llama3:8b,mistral:7b,qwen2.5:7b
# Se deixado em branco, todos os modelos instalados no Ollama são acessíveis
ALLOWED_MODELS=

# Supabase Auth e Banco de Dados (opcional para desenvolvimento local sem login)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Define se a autenticação Supabase é estritamente obrigatória em todas as rotas /api/ollama/*
# Se false (em desenvolvimento/teste local), permite testar sem JWT quando as chaves Supabase não estiverem preenchidas
REQUIRE_AUTH=false

# Limites de requisição (Rate Limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20

